# Hacker News QA Wolf Take-Home Configuration
# Copy this file to .env and customize as needed

# Base URL for Hacker News
BASE_URL=https://news.ycombinator.com/newest

# Number of articles to validate
REQUIRED_ARTICLES=100

# Run browser in headless mode (true/false)
HEADLESS=true

# Browser to use (chromium, firefox, webkit)
BROWSER=chromium

# HN Firebase API base URL
API_BASE_URL=https://hacker-news.firebaseio.com/v0

# Dashboard server port
DASHBOARD_PORT=3000

# Directory for JSON test reports
REPORTS_DIR=data/reports

# Retry configuration
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Capture screenshots on test failure (true/false)
SCREENSHOT_ON_FAILURE=true

# Log level (debug, info, warn, error)
LOG_LEVEL=info
